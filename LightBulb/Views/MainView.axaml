<Window
  x:Class="LightBulb.Views.MainView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
  xmlns:lightBulb="clr-namespace:LightBulb"
  xmlns:viewModels="clr-namespace:LightBulb.ViewModels"
  x:Name="Window"
  x:DataType="viewModels:MainViewModel"
  Title="{x:Static lightBulb:Program.Name}"
  Width="1080"
  Height="780"
  MinWidth="880"
  MinHeight="600"
  Closed="Window_OnClosed"
  Opened="Window_OnOpened"
  Icon="/favicon.ico"
  WindowDecorations="Full"
  WindowStartupLocation="CenterScreen"
  Background="{DynamicResource CandlelightSurface}"
  Foreground="{DynamicResource CandlelightText}"
  FontFamily="Segoe UI"
>
  <dialogHostAvalonia:DialogHost x:Name="DialogHost" CloseOnClickAway="False">
    <Grid RowDefinitions="Auto,*,Auto">
      <Border
        Padding="24,18"
        BorderBrush="{DynamicResource CandlelightLine}"
        BorderThickness="0,0,0,1"
      >
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20">
          <StackPanel Spacing="3">
            <TextBlock Text="Candlelight" FontSize="24" FontWeight="SemiBold" />
            <TextBlock
              Text="A luz certa em cada ecrã."
              FontSize="13"
              Foreground="{DynamicResource CandlelightMuted}"
            />
          </StackPanel>
          <ToggleSwitch
            Grid.Column="1"
            Content="Ajustes ligados"
            IsChecked="{Binding Dashboard.IsEnabled}"
            VerticalAlignment="Center"
          />
          <Button
            Grid.Column="2"
            Content="Minimizar para a bandeja"
            Click="HideButton_OnClick"
            VerticalAlignment="Center"
            Padding="14,10"
          />
        </Grid>
      </Border>
      <ContentControl Grid.Row="1" Content="{Binding Dashboard.Displays}" />
      <Border
        Grid.Row="2"
        Padding="24,12"
        BorderBrush="{DynamicResource CandlelightLine}"
        BorderThickness="0,1,0,0"
      >
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
          <TextBlock
            Text="{Binding Dashboard.Instant, StringFormat={}{0:HH:mm}}"
            Foreground="{DynamicResource CandlelightMuted}"
            VerticalAlignment="Center"
          />
          <ToggleButton
            Grid.Column="1"
            Content="Antever o dia"
            IsChecked="{Binding Dashboard.IsCyclePreviewEnabled}"
            Padding="14,10"
          />
          <Button
            Grid.Column="2"
            Content="Definições avançadas"
            Command="{Binding ShowSettingsCommand}"
            Padding="14,10"
          />
        </Grid>
      </Border>
    </Grid>
  </dialogHostAvalonia:DialogHost>
</Window>
